<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Gadget logic tests: the app project is WinForms (net472 / net10.0-windows),
       so instead of referencing it, compile the WinForms-free logic files straight
       into this assembly (internal classes stay reachable without InternalsVisibleTo).
       Only files with no WinForms dependency may be linked here. -->
  <ItemGroup>
    <!-- Platform=x64: the library's CsWin32 interop can't generate for AnyCPU (PInvoke005). -->
    <ProjectReference Include="..\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj" AdditionalProperties="Platform=x64" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LibreHardwareMonitor.Windows.Forms\UI\BarColorResolver.cs" Link="Linked\BarColorResolver.cs" />
    <Compile Include="..\LibreHardwareMonitor.Windows.Forms\UI\GradientDefaults.cs" Link="Linked\GradientDefaults.cs" />
    <Compile Include="..\LibreHardwareMonitor.Windows.Forms\UI\GadgetOrdering.cs" Link="Linked\GadgetOrdering.cs" />
    <Compile Include="..\LibreHardwareMonitor.Windows.Forms\UI\GadgetSettingLimits.cs" Link="Linked\GadgetSettingLimits.cs" />
    <Compile Include="..\LibreHardwareMonitor.Windows.Forms\UI\ThresholdInput.cs" Link="Linked\ThresholdInput.cs" />
    <Compile Include="..\LibreHardwareMonitor.Windows.Forms\UI\SensorGadgetItemSettings.cs" Link="Linked\SensorGadgetItemSettings.cs" />
    <Compile Include="..\LibreHardwareMonitor.Windows.Forms\Utilities\PersistentSettings.cs" Link="Linked\PersistentSettings.cs" />
  </ItemGroup>

</Project>
